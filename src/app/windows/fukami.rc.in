// Fukami.exe resources: the application icon and the version information shown in Explorer's Properties.
// Configured by cmake/RrvFukamiApp.cmake (version from the VERSION file).
#include <winver.h>

1 ICON "@RRV_FUKAMI_ICON@"
1 24 "@RRV_FUKAMI_MANIFEST@"  // RT_MANIFEST for the executable (CREATEPROCESS_MANIFEST_RESOURCE_ID)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @RRV_FUKAMI_VERSION_MAJOR@,@RRV_FUKAMI_VERSION_MINOR@,@RRV_FUKAMI_VERSION_PATCH@,0
PRODUCTVERSION  @RRV_FUKAMI_VERSION_MAJOR@,@RRV_FUKAMI_VERSION_MINOR@,@RRV_FUKAMI_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fukami"
            VALUE "FileVersion",     "@RRV_FUKAMI_VERSION@"
            VALUE "InternalName",    "Fukami"
            VALUE "OriginalFilename", "Fukami.exe"
            VALUE "ProductName",     "Fukami"
            VALUE "ProductVersion",  "@RRV_FUKAMI_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
