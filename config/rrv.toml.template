# RRV-Recomp configuration template
# This file is a reference; the real config/rrv.toml is generated by:
#   ./scripts/analyze.sh
#
# After generation, hand-edit rrv.toml to add stubs/skips/patches as needed.

[general]
# Path to the boot ELF (user-provided, not in git)
input  = "local/rrv_boot.elf"

# Path where generated C++ is written (gitignored)
output = "generated/"

# Optional: Ghidra-exported CSV function map (empty = not used)
ghidra_output = ""

# false = one .cpp per function (easier to debug individual functions)
# true  = single large file (faster compile, harder to navigate)
single_file_output = false

# Recommended: patch COP0 and CACHE instructions out
patch_syscalls = false
patch_cop0     = true
patch_cache    = true

# Parallel output writers (0 = auto)
output_worker_threads = 0

# Sony library functions that need HLE implementations.
# The analyzer fills this automatically from the SCE symbol fingerprint DB.
# Format: "FunctionName" or "FunctionName@0xADDRESS" for disambiguating duplicates.
stubs = [
    # Examples — analyzer will populate this:
    # "scePadInit",
    # "sceGsResetGraph",
    # "sceSifInitRpc",
]

# Functions to omit from output entirely (e.g. Sony CRT init we replace wholesale).
skip = [
    # "_start",   # replaced by our own entry point
]

# Instruction-level patches (override specific encoded instructions).
[patches]
instructions = [
    # { address = "0x00100000", value = "0x00000000" },  # NOP example
]

# Manual jump-table hints (for indirect branches the analyzer cannot infer).
[jump_tables]
# table = [
#     { address = "0x00101234", base_register = 9,
#       entries = [
#         { index = 0, target = "0x00101300" },
#         { index = 1, target = "0x00101340" },
#       ]
#     },
# ]
