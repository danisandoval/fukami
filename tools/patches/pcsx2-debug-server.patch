+	// RRV probe: opt-in MCP/TCP debug server. With RRV_GT_DEBUG_SERVER unset,
+	// no listener starts and the VSync event recorder drops records.
+	//   RRV_GT_DEBUG_SERVER=1        listen on the default port (21512)
+	//   RRV_GT_DEBUG_SERVER=<port>   listen on <port>
+	if (const char* rrv_ds = std::getenv("RRV_GT_DEBUG_SERVER"))
+	{
+		const int port = std::atoi(rrv_ds);
+		DebugServer::Start(port > 1 ? port : 21512);
+	}
+
 	PerformanceMetrics::Clear();
 	return VMBootResult::StartupSuccess;
 }
 
 void VMManager::Shutdown(bool save_resume_state)
 {
+	if (DebugServer::IsRunning())
+		DebugServer::Stop();
+
 	// we'll probably already be stopping (this is how Qt calls shutdown),
 	// but just in case, so any of the stuff we call here knows we don't have a valid VM.
 	s_state.store(VMState::Stopping, std::memory_order_release);
