--- /dev/null
+++ b/pcsx2/DebugTools/DebugServer.h
@@ -0,0 +1,93 @@
+// ---------------------------------------------------------------------------
+// RRV-Recomp provenance note (see CLAUDE.md "Reference / oracle discipline")
+//
+//   Upstream:  https://github.com/hkmodd/PCSX2-MCP
+//              pcsx2-plugin/DebugServer.{cpp,h}, MIT licensed (header below).
+//   Vendored:  2026-08-22, against pinned PCSX2
+//              d5f75c9e42064a77036466f1f4594b0507888633.
+//   RRV edits: (1) DebugInterface memory accessors renamed read*/write* ->
+//                  Read*/Write* and `bool valid` -> `bool* valid`, matching
+//                  common/MemoryInterface.h at the pinned revision;
+//              (2) BiosThread::StackTop() does not exist at the pin -> 0;
+//              (3) MipsStackWalk::Walk() takes 5 args at the pin, not 6;
+//              (4) start/stop is gated on RRV_GT_DEBUG_SERVER (default OFF) so
+//                  this is a probe, not a behaviour change to the oracle.
+//   2026-09-24: (5) read-only Gate-3 paused EE VSync event/snapshot probe
+//               against the current fd9d310 PCSX2 pin.
+//
+// MIT is GPL-3.0 compatible; the combined work stays GPL-3.0.
+// ---------------------------------------------------------------------------
+// SPDX-FileCopyrightText: 2026 PS2Recomp Debug Bridge
+// SPDX-License-Identifier: MIT
+//
+// PCSX2 Debug Server — JSON/TCP API wrapping DebugInterface
+// Drop this into pcsx2/DebugTools/ and add to CMakeLists.txt
+//
+// Features:
+//   - Full 128-bit register R/W (all 7 categories: GPR, CP0, FPR, FCR, VU0F, VU0I, GSPRIV)
+//   - Native PCSX2 disassembly
+//   - Expression evaluation with symbol lookup
+//   - Conditional breakpoints with expression conditions
+//   - Memory watchpoints (read/write/onChange)
+//   - Thread list, module list
+//   - Pause/Resume/Step execution control
+//   - Memory R/W (8/16/32/64/128 bit)
+//   - Stack walk
+
+#pragma once
+
+#include <string>
+#include <thread>
+#include <atomic>
+#include <functional>
+#include <cstdint>
+
+namespace DebugServer
+{
+	// RRV Gate-3 reference probe. Only the EE CPU thread writes these records.
+	// The TCP reader requires a paused EE before copying the bounded ring.
+	enum class VSyncProbeKind : uint32_t
+	{
+		Reset = 1, ModeChange, StartScheduled, StartAsserted,
+		StartSuppressed, FieldTransition, FieldSuppressed, EndAsserted,
+		EndSuppressed
+	};
+
+	struct VSyncProbeSnapshot
+	{
+		uint64_t ee_cycle, generation, last_sequence;
+		uint64_t vsync_start_cycle, csr, smode1, smode2, syncv;
+		uint32_t intc_stat, intc_mask, frame, vsync_mode, vsync_delta_cycles;
+		uint32_t video_mode, gs_video_mode, gs_is_interlaced;
+		uint32_t smode1_cmod, syncv_vfp_odd;
+		uint32_t render_cycles, blank_cycles, gsblank_cycles;
+		uint32_t hrender_cycles, hblank_cycles, hsync_error, scanlines;
+		double frame_rate;
+	};
+
+	struct VSyncProbeEvent
+	{
+		uint64_t sequence, scheduled_ee_cycle, csr_before;
+		uint32_t intc_before;
+		VSyncProbeKind kind;
+		VSyncProbeSnapshot state;
+	};
+
+	VSyncProbeSnapshot GetVSyncProbeSnapshot();
+	uint64_t LastVSyncEventSequence();
+	void RecordVSyncEvent(VSyncProbeKind kind, uint64_t scheduled_ee_cycle,
+		uint64_t csr_before, uint32_t intc_before);
+	// Start the debug server on the given TCP port
+	// Call this once from PCSX2 initialization (e.g. in VMManager::Initialize)
+	void Start(int port = 21512);
+
+	// Stop the server and close all connections
+	void Stop();
+
+	// Check if server is running
+	bool IsRunning();
+
+	// Called when a breakpoint is hit — wakes up any waiting step/continue
+	void OnBreakpointHit();
+
+} // namespace DebugServer
