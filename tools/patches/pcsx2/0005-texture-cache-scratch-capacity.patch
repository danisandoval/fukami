+// ReadTexture expands every target pixel to u32, including 16/24-bit formats.
+// Check before aligning, multiplying by height, or narrowing to its int pitch.
+static bool GetTargetUpdateScratchLayout(size_t width, size_t height, int& pitch, size_t& required_size)
+{
+	constexpr size_t max_size = std::numeric_limits<size_t>::max();
+	constexpr size_t alignment_mask = VECTOR_ALIGNMENT - 1;
+	if (width == 0 || height == 0 || width > (max_size - alignment_mask) / sizeof(u32))
+		return false;
+
+	const size_t aligned_pitch = VectorAlign(width * sizeof(u32));
+	if (aligned_pitch > static_cast<size_t>(std::numeric_limits<int>::max()) || height > max_size / aligned_pitch)
+		return false;
+
+	pitch = static_cast<int>(aligned_pitch);
+	required_size = aligned_pitch * height;
+	return true;
+}
+
+static constexpr size_t s_unswizzle_buffer_size = 9 * 1024 * 1024;
+using UnswizzleScratchBuffer = std::unique_ptr<u8, decltype(&_aligned_free)>;
+
+// Readers write their complete aligned rectangle. Consumers can start within
+// it and advance one complete pitch per row, so both spans must fit.
+static bool GetUnswizzleScratch(size_t pitch, size_t write_height, size_t write_row_size, size_t consumer_offset, size_t consumer_size,
+	UnswizzleScratchBuffer& oversized_buffer, u8*& scratch)
+{
+	constexpr size_t max_size = std::numeric_limits<size_t>::max();
+	if (pitch == 0 || write_height == 0 || write_height > max_size / pitch || write_row_size > max_size - ((write_height - 1) * pitch) || consumer_offset > max_size - consumer_size)
+		return false;
+
+	const size_t write_size = ((write_height - 1) * pitch) + write_row_size;
+	const size_t required_size = std::max(write_size, consumer_offset + consumer_size);
+	oversized_buffer.reset();
+	scratch = s_unswizzle_buffer;
+	if (required_size <= s_unswizzle_buffer_size)
+		return true;
+
+	oversized_buffer.reset(static_cast<u8*>(_aligned_malloc(required_size, VECTOR_ALIGNMENT)));
+	if (!oversized_buffer)
+		return false;
+
+	scratch = oversized_buffer.get();
+	return true;
+}
