+void GSRrvSetDropLargeSTTriangles(bool drop)
+{
+	GSState::s_rrv_drop_large_st_triangles = drop;
+	GSState::s_rrv_dropped_large_st_triangles.store(0, std::memory_order_relaxed);
+}
