+bool GSState::RrvReadLocalMemoryChecked(u8* mem, u32 byte_count, GIFRegBITBLTBUF BITBLTBUF,
+	GIFRegTRXPOS TRXPOS, GIFRegTRXREG TRXREG)
+{
+	// Keep descriptor validation in PCSX2 beside the transfer state. The
+	// bridge's ABI descriptors are provenance, never a second cursor.
+	constexpr u64 bitbltbuf_mask = 0x3fffull | (0x3full << 16) | (0x3full << 24) |
+		(0x3fffull << 32) | (0x3full << 48) | (0x3full << 56);
+	constexpr u64 trxpos_mask = 0x7ffull | (0x7ffull << 16) | (0x7ffull << 32) |
+		(0x7ffull << 48) | (0x3ull << 59);
+	constexpr u64 trxreg_mask = 0xfffull | (0xfffull << 32);
+	const auto descriptor_matches = [](u64 actual, u64 expected, u64 mask) {
+		return ((actual ^ expected) & mask) == 0;
+	};
+
+	if (!mem || byte_count == 0 || m_env.TRXDIR.XDIR != 1 || m_tr.write ||
+		!descriptor_matches(BITBLTBUF.U64, m_tr.m_blit.U64, bitbltbuf_mask) ||
+		!descriptor_matches(TRXPOS.U64, m_tr.m_pos.U64, trxpos_mask) ||
+		!descriptor_matches(TRXREG.U64, m_tr.m_reg.U64, trxreg_mask) ||
+		// A descriptor rewrite while a download is live must not turn the
+		// original cursor into a read of new environment state.
+		!descriptor_matches(m_env.BITBLTBUF.U64, m_tr.m_blit.U64, bitbltbuf_mask) ||
+		!descriptor_matches(m_env.TRXPOS.U64, m_tr.m_pos.U64, trxpos_mask) ||
+		!descriptor_matches(m_env.TRXREG.U64, m_tr.m_reg.U64, trxreg_mask))
+	{
+		return false;
+	}
+
+	const u64 width = m_tr.m_reg.RRW;
+	const u64 height = m_tr.m_reg.RRH;
+	// fd9d310c's native ReadImageX PSMT4 branch does not advance its output
+	// byte pointer. Do not expose a fabricated/corrupted FIFO for a format the
+	// pinned native reader cannot produce deterministically; this remains a
+	// fail-closed adapter, not a bridge-side decoder.
+	if (m_tr.m_blit.SPSM == PSMT4)
+		return false;
+	const u16 trbpp = GSLocalMemory::m_psm[m_tr.m_blit.SPSM].trbpp;
+	if (width == 0 || height == 0 || trbpp == 0)
+		return false;
+	const u64 transfer_bits = width * height * trbpp;
+	const u64 transfer_bytes = (transfer_bits + 7u) >> 3;
+	if (transfer_bytes == 0 || transfer_bytes > GSLocalMemory::m_vmsize)
+		return false;
+
+	if (m_tr.total == 0)
+	{
+		if (m_tr.start != 0 || m_tr.end != 0 || m_tr.w != static_cast<int>(width) ||
+			m_tr.h != static_cast<int>(height) || m_tr.x != static_cast<int>(m_tr.m_pos.SSAX) ||
+			m_tr.y != static_cast<int>(m_tr.m_pos.SSAY))
+			return false;
+	}
+	else if (m_tr.total != static_cast<int>(transfer_bytes) || m_tr.start != 0 ||
+		m_tr.end < 0 || m_tr.end >= m_tr.total)
+	{
+		return false;
+	}
+
+	const u64 consumed = static_cast<u64>(m_tr.end);
+	const u64 remaining = transfer_bytes - consumed;
+	if (byte_count > remaining || (byte_count != remaining && (byte_count & 15u) != 0))
+		return false;
+	const u64 qwc = (static_cast<u64>(byte_count) + 15u) / 16u;
+	if (qwc == 0 || qwc > static_cast<u64>(INT_MAX))
+		return false;
+
+	InitReadFIFO(mem, static_cast<int>(qwc));
+	ReadFIFO(mem, static_cast<int>(qwc));
+	const u64 expected_end = consumed + byte_count;
+	if (m_tr.end != static_cast<int>(expected_end))
+		return false;
+	if (expected_end == transfer_bytes)
+		return m_env.TRXDIR.XDIR == 3;
+	return m_env.TRXDIR.XDIR == 1;
+}
