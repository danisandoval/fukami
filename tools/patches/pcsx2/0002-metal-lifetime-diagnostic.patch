diff --git a/pcsx2/GS/Renderers/Metal/RRVMetalLifetimeDiag.h b/pcsx2/GS/Renderers/Metal/RRVMetalLifetimeDiag.h
new file mode 100644
index 0000000..1a1c558
--- /dev/null
+++ b/pcsx2/GS/Renderers/Metal/RRVMetalLifetimeDiag.h
@@ -0,0 +1,230 @@
+// SPDX-FileCopyrightText: 2026 RRV-Recomp contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// A deliberately small, process-lifetime diagnostic ring for the Metal
+// boundary.  It is not a renderer ownership mechanism: it never retains,
+// releases, dereferences, waits on, or otherwise changes the lifetime of the
+// objects whose pointer values it records.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace rrv::metal_lifetime
+{
+inline constexpr std::uint64_t kCapacity = 512;
+inline constexpr std::uint64_t kDrawableSlots = 8;
+inline constexpr std::uint64_t kBusyBit = std::uint64_t{1} << 63;
+
+enum class Event : std::uint64_t
+{
+	Attach = 1,
+	Detach,
+	UpdateWindow,
+	DestroySurface,
+	Destroy,
+	CommandBufferCreate,
+	Commit,
+	Complete,
+	SpinComplete,
+	DrawableAcquire,
+	DrawablePresent,
+	DeviceReady,
+	PipelineReady,
+	PresentConfig,
+	InterlaceConfig,
+};
+
+struct Record
+{
+	std::uint64_t ticket = 0;
+	std::uint64_t lifecycle = 0;
+	std::uint64_t command_buffer = 0;
+	std::uint64_t queue = 0;
+	std::uint64_t layer = 0;
+	std::uint64_t drawable = 0;
+	std::uint64_t draw = 0;
+	std::uint64_t status = 0;
+	std::uint64_t thread = 0;
+	std::uint64_t surface_width = 0;
+	std::uint64_t surface_height = 0;
+	std::uint64_t pixel_format = 0;
+	std::uint64_t reacquire_before_complete = 0;
+	Event event = Event::Attach;
+};
+
+struct Snapshot
+{
+	std::uint64_t first_ticket = 0;
+	std::uint64_t next_ticket = 1;
+	std::uint64_t overwritten = 0;
+	std::uint64_t gaps = 0;
+	std::uint64_t count = 0;
+	std::array<Record, kCapacity> records{};
+};
+
+class Ring final
+{
+	struct Slot
+	{
+		// `generation` is the ticket of a fully-published slot. The high bit is
+		// a writer lease, so snapshot readers never consume partial fields.
+		std::atomic<std::uint64_t> generation{0};
+		std::atomic<std::uint64_t> lifecycle{0};
+		std::atomic<std::uint64_t> command_buffer{0};
+		std::atomic<std::uint64_t> queue{0};
+		std::atomic<std::uint64_t> layer{0};
+		std::atomic<std::uint64_t> drawable{0};
+		std::atomic<std::uint64_t> draw{0};
+		std::atomic<std::uint64_t> status{0};
+		std::atomic<std::uint64_t> thread{0};
+		std::atomic<std::uint64_t> event{0};
+		std::atomic<std::uint64_t> surface_width{0};
+		std::atomic<std::uint64_t> surface_height{0};
+		std::atomic<std::uint64_t> pixel_format{0};
+		std::atomic<std::uint64_t> reacquire_before_complete{0};
+	};
+
+	std::array<Slot, kCapacity> m_slots{};
+	std::atomic<std::uint64_t> m_next_ticket{1};
+	std::atomic<std::uint64_t> m_lifecycle{0};
+	std::atomic<bool> m_configured{false};
+	std::atomic<bool> m_enabled{false};
+	// Eight slots cover the normal Metal drawable ring without allocating or
+	// retaining it. A hash collision can only make this diagnostic conservative
+	// (a missed flag), never alter presentation ownership.
+	std::array<std::atomic<std::uint64_t>, kDrawableSlots> m_pending_drawables{};
+
+public:
+	void configureAtCreate()
+	{
+		bool expected = false;
+		if (m_configured.compare_exchange_strong(expected, true, std::memory_order_acq_rel))
+		{
+			const char* value = std::getenv("RRV_METAL_LIFETIME_DIAG");
+			m_enabled.store(value && std::strcmp(value, "1") == 0, std::memory_order_release);
+		}
+	}
+
+	void startLifecycle()
+	{
+		if (m_enabled.load(std::memory_order_relaxed))
+			m_lifecycle.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	bool enabled() const { return m_enabled.load(std::memory_order_relaxed); }
+
+	// Test-only setup has no production call sites. It allows the fixed-size
+	// protocol to be stressed without reading the process environment.
+	void enableForTest()
+	{
+		m_configured.store(true, std::memory_order_relaxed);
+		m_enabled.store(true, std::memory_order_relaxed);
+		m_lifecycle.store(1, std::memory_order_relaxed);
+	}
+
+	void record(Event event, std::uint64_t command_buffer, std::uint64_t queue,
+		std::uint64_t layer, std::uint64_t drawable, std::uint64_t draw,
+		std::uint64_t status, std::uint64_t thread, std::uint64_t surface_width = 0,
+		std::uint64_t surface_height = 0, std::uint64_t pixel_format = 0,
+		std::uint64_t reacquire_before_complete = 0)
+	{
+		if (!m_enabled.load(std::memory_order_relaxed))
+			return;
+
+		const std::uint64_t ticket = m_next_ticket.fetch_add(1, std::memory_order_relaxed);
+		Slot& slot = m_slots[ticket % kCapacity];
+		std::uint64_t generation = slot.generation.load(std::memory_order_acquire);
+		// Never wait for another recorder, including a completion callback. A busy,
+		// newer, or contended slot drops this ticket; snapshot() reports that gap.
+		if ((generation & kBusyBit) || generation >= ticket ||
+			!slot.generation.compare_exchange_strong(generation, ticket | kBusyBit,
+				std::memory_order_acquire, std::memory_order_acquire))
+			return;
+
+		slot.lifecycle.store(m_lifecycle.load(std::memory_order_relaxed), std::memory_order_relaxed);
+		slot.command_buffer.store(command_buffer, std::memory_order_relaxed);
+		slot.queue.store(queue, std::memory_order_relaxed);
+		slot.layer.store(layer, std::memory_order_relaxed);
+		slot.drawable.store(drawable, std::memory_order_relaxed);
+		slot.draw.store(draw, std::memory_order_relaxed);
+		slot.status.store(status, std::memory_order_relaxed);
+		slot.thread.store(thread, std::memory_order_relaxed);
+		slot.event.store(static_cast<std::uint64_t>(event), std::memory_order_relaxed);
+		slot.surface_width.store(surface_width, std::memory_order_relaxed);
+		slot.surface_height.store(surface_height, std::memory_order_relaxed);
+		slot.pixel_format.store(pixel_format, std::memory_order_relaxed);
+		slot.reacquire_before_complete.store(reacquire_before_complete, std::memory_order_relaxed);
+		slot.generation.store(ticket, std::memory_order_release);
+	}
+
+	bool drawableIsPending(std::uint64_t drawable) const
+	{
+		return enabled() && drawable != 0 && m_pending_drawables[(drawable >> 4) % kDrawableSlots].load(std::memory_order_acquire) == drawable;
+	}
+
+	void markDrawablePresented(std::uint64_t drawable)
+	{
+		if (enabled() && drawable != 0)
+			m_pending_drawables[(drawable >> 4) % kDrawableSlots].store(drawable, std::memory_order_release);
+	}
+
+	void markDrawableCompleted(std::uint64_t drawable)
+	{
+		if (!enabled() || drawable == 0)
+			return;
+		std::atomic<std::uint64_t>& pending = m_pending_drawables[(drawable >> 4) % kDrawableSlots];
+		std::uint64_t expected = drawable;
+		pending.compare_exchange_strong(expected, 0, std::memory_order_acq_rel);
+	}
+
+	void forceBusySlotForTest(std::uint64_t ticket)
+	{
+		m_slots[ticket % kCapacity].generation.store(ticket | kBusyBit, std::memory_order_release);
+	}
+
+	Snapshot snapshot() const
+	{
+		Snapshot result;
+		result.next_ticket = m_next_ticket.load(std::memory_order_acquire);
+		result.first_ticket = result.next_ticket > kCapacity ? result.next_ticket - kCapacity : 1;
+		result.overwritten = result.first_ticket - 1;
+		for (std::uint64_t ticket = result.first_ticket; ticket < result.next_ticket; ++ticket)
+		{
+			const Slot& slot = m_slots[ticket % kCapacity];
+			const std::uint64_t before = slot.generation.load(std::memory_order_acquire);
+			if (before != ticket)
+			{
+				++result.gaps;
+				continue;
+			}
+			Record& record = result.records[result.count];
+			record.ticket = ticket;
+			record.lifecycle = slot.lifecycle.load(std::memory_order_relaxed);
+			record.command_buffer = slot.command_buffer.load(std::memory_order_relaxed);
+			record.queue = slot.queue.load(std::memory_order_relaxed);
+			record.layer = slot.layer.load(std::memory_order_relaxed);
+			record.drawable = slot.drawable.load(std::memory_order_relaxed);
+			record.draw = slot.draw.load(std::memory_order_relaxed);
+			record.status = slot.status.load(std::memory_order_relaxed);
+			record.thread = slot.thread.load(std::memory_order_relaxed);
+			record.surface_width = slot.surface_width.load(std::memory_order_relaxed);
+			record.surface_height = slot.surface_height.load(std::memory_order_relaxed);
+			record.pixel_format = slot.pixel_format.load(std::memory_order_relaxed);
+			record.reacquire_before_complete = slot.reacquire_before_complete.load(std::memory_order_relaxed);
+			record.event = static_cast<Event>(slot.event.load(std::memory_order_relaxed));
+			if (slot.generation.load(std::memory_order_acquire) != ticket)
+			{
+				++result.gaps;
+				continue;
+			}
+			++result.count;
+		}
+		return result;
+	}
+};
+} // namespace rrv::metal_lifetime
