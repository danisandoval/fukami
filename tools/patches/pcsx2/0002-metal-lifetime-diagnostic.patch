+// LLDB: `expr -- GSRrvMetalLifetimeDump()` after a failed run. These hooks are
+// intentionally local to the renderer and are not exported through the bridge ABI.
+extern "C" void GSRrvMetalLifetimeDump()
+{
+	const rrv::metal_lifetime::Snapshot snapshot = s_rrv_metal_lifetime.snapshot();
+	Console.WriteLn("RRV Metal lifetime: first=%llu next=%llu overwritten=%llu gaps=%llu records=%llu",
+		static_cast<unsigned long long>(snapshot.first_ticket), static_cast<unsigned long long>(snapshot.next_ticket),
+		static_cast<unsigned long long>(snapshot.overwritten), static_cast<unsigned long long>(snapshot.gaps),
+		static_cast<unsigned long long>(snapshot.count));
+	for (u64 index = 0; index < snapshot.count; ++index)
+	{
+		const rrv::metal_lifetime::Record& record = snapshot.records[index];
+		Console.WriteLn("RRV Metal lifetime: ticket=%llu lifecycle=%llu event=%s cb=0x%llx queue=0x%llx layer=0x%llx drawable=0x%llx draw=%llu status=%llu thread=0x%llx size=%llux%llu format=%llu reacquire-pending=%llu",
+			static_cast<unsigned long long>(record.ticket), static_cast<unsigned long long>(record.lifecycle),
+			RrvMetalLifetimeEventName(record.event), static_cast<unsigned long long>(record.command_buffer),
+			static_cast<unsigned long long>(record.queue), static_cast<unsigned long long>(record.layer),
+			static_cast<unsigned long long>(record.drawable), static_cast<unsigned long long>(record.draw),
+			static_cast<unsigned long long>(record.status), static_cast<unsigned long long>(record.thread),
+			static_cast<unsigned long long>(record.surface_width), static_cast<unsigned long long>(record.surface_height),
+			static_cast<unsigned long long>(record.pixel_format), static_cast<unsigned long long>(record.reacquire_before_complete));
+	}
+}
+
+extern "C" void GSRrvMetalLifetimeSnapshot()
+{
+	GSRrvMetalLifetimeDump();
+}
