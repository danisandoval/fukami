+{
+	GSState::s_rrv_native_blur_block = scratch_block;
+	GSState::s_rrv_native_blur_draws[0].store(0, std::memory_order_relaxed);
+	GSState::s_rrv_native_blur_draws[1].store(0, std::memory_order_relaxed);
