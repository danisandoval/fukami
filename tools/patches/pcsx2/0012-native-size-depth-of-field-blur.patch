+			du == 16 && dv == 16 && !PRIM->ABE)
+		{
+			m_rrv_blur_pass = 1;
+			m_downscale_source = true;
+			s_rrv_native_blur_draws[0].fetch_add(1, std::memory_order_relaxed);
+		}
+		else if (sprite_32x16 && m_cached_ctx.TEX0.TBP0 == blur_block && m_cached_ctx.FRAME.Block() != blur_block &&
