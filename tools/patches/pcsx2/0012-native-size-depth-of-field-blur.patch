+		src->m_from_target->GetScale() == target_scale &&
+		m_vt.m_primclass == GS_SPRITE_CLASS && PRIM->TME && PRIM->FST && m_vt.IsRealLinear() &&
+		!m_texture_shuffle && !m_channel_shuffle &&
+		m_cached_ctx.TEX0.PSM == PSMCT32 && m_cached_ctx.FRAME.PSM == PSMCT32 &&
+		m_cached_ctx.TEX0.TBW == m_cached_ctx.FRAME.FBW)
