+	{
+		r_masked = (r_masked & 0x0000FFFFULL) | (static_cast<u64>(s_rrv_ofy_to) << 32);
+		s_rrv_ofy_canonical_count.fetch_add(1, std::memory_order_relaxed);
+	}
 
 	if (i == m_prev_env.PRIM.CTXT)
