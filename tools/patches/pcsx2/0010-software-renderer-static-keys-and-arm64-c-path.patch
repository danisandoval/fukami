+__ri static GSVector4i RrvArm64PerPixelLod(const GSVector4& q, const GSScanlineGlobalData& global)
+{
+	const uint32x4_t qu = vreinterpretq_u32_f32(q.v4s);
+	const int32x4_t exp = vsubq_s32(vreinterpretq_s32_u32(vshrq_n_u32(vshlq_n_u32(qu, 1), 24)), vdupq_n_s32(127));
