+	const float32x4_t one = vdupq_n_f32(global.const_log2_coef[3]);
+	const float32x4_t m = vreinterpretq_f32_u32(vorrq_u32(vshrq_n_u32(vshlq_n_u32(qu, 9), 9), vreinterpretq_u32_f32(one)));
+	const float32x4_t c0 = vdupq_n_f32(global.const_log2_coef[0]);
+	const float32x4_t c1 = vdupq_n_f32(global.const_log2_coef[1]);
+	const float32x4_t c2 = vdupq_n_f32(global.const_log2_coef[2]);
+	const float32x4_t p1 = vfmaq_f32(c1, m, c0); // c0 * m + c1
+	const float32x4_t p2 = vfmaq_f32(c2, p1, m); // (c0 * m + c1) * m + c2
+	const float32x4_t lg = vfmaq_f32(e, vsubq_f32(m, one), p2); // log2(q)
+	float32x4_t lod = vfmaq_f32(global.k.v4s, lg, global.l.v4s); // k + log2(q) * l
+	lod = vminnmq_f32(lod, global.mxl.v4s);
+	lod = vmaxnmq_f32(lod, vdupq_n_f32(0.0f));
+	return GSVector4i(vcvtq_s32_f32(lod));
