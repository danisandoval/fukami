+// ---------------------------------------------------------------------------
+// RRV bridge: ahead-of-time specialised rasterizer functions.
+//
+// The generic C functions above take the selector at run time. Instantiating
+// them with the selector as a compile-time constant lets the compiler fold
+// every `sel.*` branch, which is what the runtime JIT does by generating code
+// per selector. GSDrawScanlineStaticKeys.inc lists the selectors to
+// instantiate (selector keys only: no game data). Selectors that are not in
+// the table use the generic C functions, which draw the same pixels.
+// ---------------------------------------------------------------------------
+
+template <u64 KEY>
+void GSDrawScanline::CDrawScanlineT(int pixels, int left, int top, const GSVertexSW& scan, GSScanlineLocalData& local)
+{
+	CDrawScanline(pixels, left, top, scan, local, GSScanlineSelector(KEY));
+}
+
+template <u64 KEY>
+void GSDrawScanline::CSetupPrimT(const GSVertexSW* vertex, const u16* index, const GSVertexSW& dscan, GSScanlineLocalData& local)
+{
+	CSetupPrim(vertex, index, dscan, local, GSScanlineSelector(KEY));
+}
+
+u64 GSDrawScanline::SetupPrimKey(GSScanlineSelector global_sel)
+{
+	// The fields CSetupPrim / the SetupPrim JIT read (same subset as the JIT
+	// function map key in SetupDraw).
+	GSScanlineSelector sel;
+	sel.key = 0;
+	sel.iip = global_sel.iip;
+	sel.tfx = global_sel.tfx;
+	sel.tcc = global_sel.tcc;
+	sel.fst = global_sel.fst;
+	sel.fge = global_sel.fge;
+	sel.prim = global_sel.prim;
+	sel.fb = global_sel.fb;
+	sel.zb = global_sel.zb;
+	sel.zoverflow = global_sel.zoverflow;
+	sel.zequal = global_sel.zequal;
+	sel.notest = global_sel.notest;
+	return sel.key;
+}
+
+u64 GSDrawScanline::EdgeKey(GSScanlineSelector global_sel)
+{
+	GSScanlineSelector sel = global_sel;
+	sel.zwrite = 0;
+	sel.edge = 1;
+	return sel.key;
+}
+
+namespace
+{
+	struct RrvStaticDrawScanline
+	{
+		u64 key;
+		GSDrawScanline::DrawScanlinePtr fn;
+	};
+
+	struct RrvStaticSetupPrim
+	{
+		u64 key;
+		GSDrawScanline::SetupPrimPtr fn;
+	};
+} // namespace
+
+#define RRV_SW_DS_KEY(k) {UINT64_C(k), &GSDrawScanline::CDrawScanlineT<UINT64_C(k)>},
+#define RRV_SW_SP_KEY(k)
+static const RrvStaticDrawScanline s_rrv_static_ds[] = {
+#include "GS/Renderers/SW/GSDrawScanlineStaticKeys.inc"
+	{~UINT64_C(0), nullptr}, // sentinel, sorts last
+};
+#undef RRV_SW_DS_KEY
+#undef RRV_SW_SP_KEY
+
+#define RRV_SW_DS_KEY(k)
+#define RRV_SW_SP_KEY(k) {UINT64_C(k), &GSDrawScanline::CSetupPrimT<UINT64_C(k)>},
+static const RrvStaticSetupPrim s_rrv_static_sp[] = {
+#include "GS/Renderers/SW/GSDrawScanlineStaticKeys.inc"
+	{~UINT64_C(0), nullptr}, // sentinel, sorts last
+};
+#undef RRV_SW_DS_KEY
+#undef RRV_SW_SP_KEY
+
+template <class T, size_t N>
+static decltype(T::fn) RrvLookupStatic(const T (&table)[N], u64 key)
+{
+	// Tables are emitted sorted by key (the generator sorts them; checked once).
+	size_t lo = 0, hi = N - 1; // exclude the sentinel
+	while (lo < hi)
+	{
+		const size_t mid = (lo + hi) / 2;
+		if (table[mid].key < key)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return (lo < N - 1 && table[lo].key == key) ? table[lo].fn : nullptr;
+}
+
+template <class T, size_t N>
+static bool RrvTableSorted(const T (&table)[N])
+{
+	for (size_t i = 1; i < N; i++)
+	{
+		if (!(table[i - 1].key < table[i].key))
+			return false;
+	}
+	return true;
+}
+
+void GSDrawScanline::GetStaticFunctions(GSScanlineSelector sel, SetupPrimPtr& setup_prim, DrawScanlinePtr& draw_scanline, DrawScanlinePtr& draw_edge)
+{
+	static const bool s_sorted = [] {
+		const bool ok = RrvTableSorted(s_rrv_static_ds) && RrvTableSorted(s_rrv_static_sp);
+		if (!ok)
+			std::fprintf(stderr, "[pcsx2-sw] static rasterizer table is not sorted; using generic C functions only\n");
+		return ok;
+	}();
+
+	DrawScanlinePtr ds = s_sorted ? RrvLookupStatic(s_rrv_static_ds, sel.key) : nullptr;
+	SetupPrimPtr sp = s_sorted ? RrvLookupStatic(s_rrv_static_sp, SetupPrimKey(sel)) : nullptr;
+
+	draw_scanline = ds ? ds : static_cast<DrawScanlinePtr>(&GSDrawScanline::CDrawScanline);
+	setup_prim = sp ? sp : static_cast<SetupPrimPtr>(&GSDrawScanline::CSetupPrim);
+
+	if (sel.aa1)
+	{
+		DrawScanlinePtr de = s_sorted ? RrvLookupStatic(s_rrv_static_ds, EdgeKey(sel)) : nullptr;
+		draw_edge = de ? de : &GSDrawScanline::CDrawEdge;
+	}
+	else
+	{
+		draw_edge = nullptr;
+	}
+}
+
+size_t GSDrawScanline::StaticTableSize()
+{
+	return std::size(s_rrv_static_ds) - 1;
+}
+
+// RRV_PCSX2_GS_SW_KEYS=<path>: record every rasterizer selector used (the
+// draw key, its edge key for AA1 draws, and the SetupPrim key), rewriting
+// <path> whenever a new one appears. This is how the static table is
+// harvested. Keys are GS register-state bit fields, not game data.
+void GSDrawScanline::RrvNoteSelector(GSScanlineSelector sel)
+{
+	static const char* const s_path = [] {
+		const char* p = std::getenv("RRV_PCSX2_GS_SW_KEYS");
+		return (p && p[0]) ? p : nullptr;
+	}();
+	if (!s_path)
+		return;
+
+	static std::mutex s_mutex;
+	static std::map<u64, u64> s_ds; // key -> draws
+	static std::map<u64, u64> s_sp;
+	static u64 s_total = 0;
+
+	std::lock_guard<std::mutex> lock(s_mutex);
+	bool added = false;
+	auto note = [&added](std::map<u64, u64>& m, u64 k) {
+		auto [it, inserted] = m.try_emplace(k, 0);
+		it->second++;
+		added |= inserted;
+	};
+	note(s_ds, sel.key);
+	if (sel.aa1)
+		note(s_ds, EdgeKey(sel));
+	note(s_sp, SetupPrimKey(sel));
+	s_total++;
+
+	if (!added && (s_total & 4095) != 0)
+		return;
+
+	const std::string tmp = std::string(s_path) + ".tmp";
+	FILE* f = std::fopen(tmp.c_str(), "w");
+	if (!f)
+		return;
+	std::fprintf(f, "# rrv pcsx2 sw rasterizer selectors: draws=%llu static_table=%zu\n",
+		static_cast<unsigned long long>(s_total), StaticTableSize());
+	for (const auto& [k, n] : s_ds)
+	{
+		std::fprintf(f, "ds %016llX %llu %s %s\n", static_cast<unsigned long long>(k), static_cast<unsigned long long>(n),
+			RrvLookupStatic(s_rrv_static_ds, k) ? "static" : "generic", GSScanlineSelector(k).to_string().c_str());
+	}
+	for (const auto& [k, n] : s_sp)
+	{
+		std::fprintf(f, "sp %016llX %llu %s\n", static_cast<unsigned long long>(k), static_cast<unsigned long long>(n),
+			RrvLookupStatic(s_rrv_static_sp, k) ? "static" : "generic");
+	}
+	std::fclose(f);
+	std::rename(tmp.c_str(), s_path);
+}
