+#if defined(RRV_PCSX2_GS_SW_JIT)
+// ---------------------------------------------------------------------------
+// RRV_PCSX2_GS_SW_DIFF=<summary path>: differential check of the ahead-of-time
+// rasterizer functions against PCSX2's runtime JIT (diagnostic builds only).
+// The JIT draws into GS local memory as usual; the static (or generic C)
+// functions draw the same spans into a shadow copy taken at the start of the
+// draw. Each span's frame/Z pixels are compared (and the shadow resynced on a
+// mismatch, so spans are judged independently); a whole-memory compare at the
+// end of the draw catches writes outside the spans. Per-selector counts go to
+// the summary file; the first mismatches of each selector go to stderr.
+// ---------------------------------------------------------------------------
+namespace
+{
+	struct RrvSwDiffKeyStats
+	{
+		u64 draws = 0;
+		u64 spans = 0;
+		u64 bad_spans = 0;
+		u64 bad_pixels = 0;
+		u64 bad_draws_full = 0;
+		u64 reported = 0;
+		bool dirty = false;
+	};
+
+	struct RrvSwDiffState
+	{
+		const char* path = nullptr;
+		std::map<u64, RrvSwDiffKeyStats> keys;
+		u64 draws = 0;
+		u64 spans = 0;
+		u64 bad_spans = 0;
+		u64 bad_draws_full = 0;
+		u64 full_reported = 0;
+	};
+
+	void RrvDiffWriteSummary(const RrvSwDiffState& st);
+
+	RrvSwDiffState& RrvDiffState()
+	{
+		static RrvSwDiffState s_state = [] {
+			RrvSwDiffState st;
+			const char* p = std::getenv("RRV_PCSX2_GS_SW_DIFF");
+			st.path = (p && p[0]) ? p : nullptr;
+			if (st.path)
+				std::fprintf(stderr, "[pcsx2-sw-diff] enabled: JIT vs static rasterizer, summary %s (static table %zu keys)\n",
+					st.path, GSDrawScanline::StaticTableSize());
+			return st;
+		}();
+		// Registered after s_state is constructed, so it runs before s_state is destroyed.
+		static const bool s_final_summary = [] {
+			if (s_state.path)
+				std::atexit([] { RrvDiffWriteSummary(s_state); });
+			return true;
+		}();
+		(void)s_final_summary;
+		return s_state;
+	}
+
+	void RrvDiffWriteSummary(const RrvSwDiffState& st)
+	{
+		const std::string tmp = std::string(st.path) + ".tmp";
+		FILE* f = std::fopen(tmp.c_str(), "w");
+		if (!f)
+			return;
+		std::fprintf(f, "# rrv pcsx2 sw diff: draws=%llu spans=%llu bad_spans=%llu bad_draws_full=%llu keys=%zu\n",
+			static_cast<unsigned long long>(st.draws), static_cast<unsigned long long>(st.spans),
+			static_cast<unsigned long long>(st.bad_spans), static_cast<unsigned long long>(st.bad_draws_full), st.keys.size());
+		for (const auto& [k, v] : st.keys)
+		{
+			std::fprintf(f, "key %016llX draws %llu spans %llu bad_spans %llu bad_pixels %llu bad_draws_full %llu %s\n",
+				static_cast<unsigned long long>(k), static_cast<unsigned long long>(v.draws),
+				static_cast<unsigned long long>(v.spans), static_cast<unsigned long long>(v.bad_spans),
+				static_cast<unsigned long long>(v.bad_pixels), static_cast<unsigned long long>(v.bad_draws_full),
+				GSScanlineSelector(k).to_string().c_str());
+		}
+		std::fclose(f);
+		std::rename(tmp.c_str(), st.path);
+	}
+
+	static const int s_rrv_offsets[] = {0, 2, 8, 10}; // columnTable16[0], as GSDrawScanline.cpp s_offsets
+
+	void RrvDumpVec(const char* name, const void* p)
+	{
+		u32 v[4];
+		std::memcpy(v, p, sizeof(v));
+		std::fprintf(stderr, " %s=%08x,%08x,%08x,%08x", name, v[0], v[1], v[2], v[3]);
+	}
+
+	void RrvDumpLocal(const char* who, const GSScanlineLocalData& l)
+	{
+#if _M_SSE < 0x501
+		std::fprintf(stderr, "[pcsx2-sw-diff]   %s:", who);
+		RrvDumpVec("d0.z", &l.d[0].z);
+		RrvDumpVec("d0.s", &l.d[0].s);
+		RrvDumpVec("d0.t", &l.d[0].t);
+		RrvDumpVec("d0.q", &l.d[0].q);
+		RrvDumpVec("d0.rb", &l.d[0].rb);
+		RrvDumpVec("d0.ga", &l.d[0].ga);
+		RrvDumpVec("d0.f", &l.d[0].f);
+		RrvDumpVec("d1.s", &l.d[1].s);
+		RrvDumpVec("d3.s", &l.d[3].s);
+		RrvDumpVec("d4.z", &l.d4.z);
+		RrvDumpVec("d4.stq", &l.d4.stq);
+		RrvDumpVec("d4.c", &l.d4.c);
+		RrvDumpVec("d4.f", &l.d4.f);
+		RrvDumpVec("c.rb", &l.c.rb);
+		RrvDumpVec("c.ga", &l.c.ga);
+		RrvDumpVec("p.z", &l.p.z);
+		RrvDumpVec("p.f", &l.p.f);
+		std::fprintf(stderr, "\n");
+#else
+		(void)who;
+		(void)l;
+#endif
+	}
+} // namespace
+
+struct alignas(32) GSRasterizer::RrvTwin
+{
+	GSScanlineLocalData local = {};
+	GSScanlineGlobalData global;
+	GSDrawScanline::SetupPrimPtr sp = nullptr;
+	GSDrawScanline::DrawScanlinePtr ds = nullptr;
+	GSDrawScanline::DrawScanlinePtr de = nullptr;
+	u8* shadow = nullptr;
+	RrvSwDiffKeyStats* stats = nullptr;
+	u64 key = 0;
+	int primclass = 0;
+};
+
+void GSRasterizer::RrvTwinBegin(const GSRasterizerData& data)
+{
+	RrvSwDiffState& st = RrvDiffState();
+	m_rrv_twin = nullptr;
+	if (!st.path || m_threads != 1)
+		return;
+
+	if (!m_rrv_twin_store)
+	{
+		m_rrv_twin_store = new RrvTwin();
+		m_rrv_twin_store->shadow = static_cast<u8*>(_aligned_malloc(VM_SIZE + 4096, 64));
+		std::memset(m_rrv_twin_store->shadow, 0, VM_SIZE + 4096);
+	}
+
+	RrvTwin* t = m_rrv_twin_store;
+	std::memcpy(t->shadow, data.global.vm, VM_SIZE);
+	t->global = data.global;
+	t->global.vm = t->shadow;
+	GSDrawScanline::GetStaticFunctions(data.global.sel, t->sp, t->ds, t->de);
+	t->local = {};
+	t->local.gd = &t->global;
+	t->local.temp.uv_minmax[0] = m_local.temp.uv_minmax[0];
+	t->local.temp.uv_minmax[1] = m_local.temp.uv_minmax[1];
+	t->key = data.global.sel.key;
+	t->primclass = data.primclass;
+	t->stats = &st.keys[t->key];
+	t->stats->draws++;
+	m_rrv_twin = t;
+}
+
+void GSRasterizer::RrvTwinSpan(int pixels, int left, int top, const GSVertexSW& scan, bool edge)
+{
+	RrvTwin* t = m_rrv_twin;
+	RrvSwDiffState& st = RrvDiffState();
+	(edge ? t->de : t->ds)(pixels, left, top, scan, t->local);
+
+	GSScanlineSelector sel(edge ? GSDrawScanline::EdgeKey(t->global.sel) : t->global.sel.key);
+	t->stats->spans++;
+	st.spans++;
+
+	const u8* vm = static_cast<const u8*>(m_local.gd->vm);
+	u8* sh = t->shadow;
+	const GSVector2i* fzbr = t->global.fzbr;
+	const GSVector2i* fzbc = t->global.fzbc;
+
+	int bad = 0;
+	struct BadPixel { int x; u32 jf, cf, jz, cz; };
+	BadPixel list[8];
+	for (int x = left; x < left + pixels; x++)
+	{
+		const int i = x & 3;
+		bool pixel_bad = false;
+		BadPixel b = {x, 0, 0, 0, 0};
+		if (sel.fwrite)
+		{
+			const u32 fa = static_cast<u32>(fzbr[top].x + fzbc[x >> 2].x) & (HALF_VM_SIZE - 1);
+			const size_t off = static_cast<size_t>(fa) * 2 + s_rrv_offsets[i] * 2;
+			const size_t n = sel.fpsm == 2 ? 2 : 4;
+			std::memcpy(&b.jf, vm + off, n);
+			std::memcpy(&b.cf, sh + off, n);
+			if (b.jf != b.cf)
+			{
+				pixel_bad = true;
+				std::memcpy(sh + off, vm + off, n);
+			}
+		}
+		if (sel.zwrite)
+		{
+			const u32 za = static_cast<u32>(fzbr[top].y + fzbc[x >> 2].y) & (HALF_VM_SIZE - 1);
+			const size_t off = static_cast<size_t>(za) * 2 + s_rrv_offsets[i] * 2;
+			const size_t n = sel.zpsm == 2 ? 2 : 4;
+			std::memcpy(&b.jz, vm + off, n);
+			std::memcpy(&b.cz, sh + off, n);
+			if (b.jz != b.cz)
+			{
+				pixel_bad = true;
+				std::memcpy(sh + off, vm + off, n);
+			}
+		}
+		if (pixel_bad)
+		{
+			if (bad < 8)
+				list[bad] = b;
+			bad++;
+		}
+	}
+
+	if (bad == 0)
+		return;
+
+	t->stats->bad_spans++;
+	t->stats->bad_pixels += bad;
+	t->stats->dirty = true;
+	st.bad_spans++;
+	if (t->stats->reported++ < 4)
+	{
+		std::fprintf(stderr, "[pcsx2-sw-diff] MISMATCH key=%016llX%s prim=%d span pixels=%d left=%d top=%d bad=%d sel{%s}\n",
+			static_cast<unsigned long long>(t->key), edge ? " (edge)" : "", t->primclass, pixels, left, top, bad,
+			sel.to_string().c_str());
+		std::fprintf(stderr, "[pcsx2-sw-diff]   scan p=%.9g,%.9g,%.9g,%.9g t=%.9g,%.9g,%.9g,%.9g c=%.9g,%.9g,%.9g,%.9g\n",
+			scan.p.x, scan.p.y, scan.p.z, scan.p.w, scan.t.x, scan.t.y, scan.t.z, scan.t.w,
+			scan.c.x, scan.c.y, scan.c.z, scan.c.w);
+		for (int k = 0; k < std::min(bad, 8); k++)
+		{
+			std::fprintf(stderr, "[pcsx2-sw-diff]   x=%d frame jit=%08x c=%08x z jit=%08x c=%08x\n",
+				list[k].x, list[k].jf, list[k].cf, list[k].jz, list[k].cz);
+		}
+		RrvDumpLocal("jit-local", m_local);
+		RrvDumpLocal("c-local  ", t->local);
+	}
+}
+
+void GSRasterizer::RrvTwinEnd(const GSRasterizerData& data)
+{
+	RrvTwin* t = m_rrv_twin;
+	if (!t)
+		return;
+	m_rrv_twin = nullptr;
+	RrvSwDiffState& st = RrvDiffState();
+	st.draws++;
+
+	const u8* vm = static_cast<const u8*>(data.global.vm);
+	if (std::memcmp(vm, t->shadow, VM_SIZE) != 0)
+	{
+		st.bad_draws_full++;
+		t->stats->bad_draws_full++;
+		if (st.full_reported++ < 16)
+		{
+			size_t first = 0, count = 0;
+			for (size_t o = 0; o < VM_SIZE; o += 4)
+			{
+				if (std::memcmp(vm + o, t->shadow + o, 4) != 0)
+				{
+					if (count++ == 0)
+						first = o;
+				}
+			}
+			u32 jv, cv;
+			std::memcpy(&jv, vm + first, 4);
+			std::memcpy(&cv, t->shadow + first, 4);
+			std::fprintf(stderr, "[pcsx2-sw-diff] OUTSIDE-SPAN key=%016llX prim=%d words=%zu first=0x%zx jit=%08x c=%08x\n",
+				static_cast<unsigned long long>(t->key), t->primclass, count, first, jv, cv);
+		}
+	}
+
+	if ((st.draws & 255) == 0 || t->stats->draws == 1 || t->stats->dirty || t->stats->bad_draws_full == 1)
+	{
+		t->stats->dirty = false;
+		RrvDiffWriteSummary(st);
+	}
+}
