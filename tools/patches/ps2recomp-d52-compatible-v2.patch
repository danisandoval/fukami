+// Runs as much of the microprogram as the recompiler can, then reports how far
+// it got. Returns true when the E bit ended the program (nothing more to run).
+bool VU1Interpreter::jitRun(uint8_t *vuCode, uint32_t codeSize,
+                            uint32_t maxCycles, uint32_t &slotsExecuted)
+{
+    slotsExecuted = 0;
+    return m_jit->run(vuCode, codeSize, maxCycles, slotsExecuted);
+}
