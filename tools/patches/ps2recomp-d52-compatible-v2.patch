+// Register file: Tn at 0x10000000 + n*0x800, with COUNT +0x00, MODE +0x10,
+// COMP +0x20, HOLD +0x30. COUNT is 16-bit.
+//
+// MODE bits used here (PCSX2 `Counters.h` Mode union):
+//   1:0 CLKS  clock select   2:  GATE (unmodelled — see below)
+//   6   ZRET  zero on compare 7:  CUE  counter enable
+//   10  EQUF  compare flag (write 1 to clear)
+//   11  OVFF  overflow flag (write 1 to clear)
+//
+// PCSX2 expresses the clock as EE cycles per tick: 2, 32, 512, or one
+// scanline. EE clock is 294,912,000 Hz, so the tick rates below are
+// EE/2, EE/32, EE/512 and the NTSC horizontal rate.
+//
+// NOT modelled, deliberately: gate mode (MODE.GATE / GATS / GATM). Nothing in
+// RR5 programs it, and faking a gate is worse than leaving it inert — a gated
+// counter that free-runs is a different bug, not a smaller one. If a guest ever
+// sets GATE, this model is wrong for that timer and the fix is to add it, not to
+// reinterpret the numbers.
+namespace
+{
+    constexpr uint64_t kEeClockHz = 294912000ull;
+
+    // EE cycles per tick, matching PCSX2's `counters[i].rate`.
+    uint64_t eeTimerTickHz(uint32_t mode)
+    {
+        switch (mode & 0x3u)
+        {
+        case 0: return kEeClockHz / 2ull;      // BUSCLK      147.456 MHz
+        case 1: return kEeClockHz / 32ull;     // BUSCLK/16     9.216 MHz
+        case 2: return kEeClockHz / 512ull;    // BUSCLK/256      576 kHz
+        default: break;
+        }
+        // CLKS=3 is HBLANK: one tick per scanline. NTSC interlaced,
+        // 59.94 Hz * 262.5 lines per field = 15,734.26 Hz.
+        return 15734ull;
+    }
+
+    uint64_t eeTimerNowNs()
+    {
+        return static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch())
+                .count());
+    }
+
+    // RRV_EE_TIMERS=0 restores the old always-zero behaviour as a rollback.
+    bool eeTimersEnabled()
+    {
+        static const bool s_on = [] {
+            const char *v = std::getenv("RRV_EE_TIMERS");
+            return !(v && v[0] == '0' && v[1] == '\0');
+        }();
+        return s_on;
+    }
+}
+
+// Returns the timer index for an EE timer register address, or -1. `regIndex`
+// receives 0=COUNT, 1=MODE, 2=COMP, 3=HOLD.
+int PS2Memory::eeTimerDecode(uint32_t address, uint32_t *regIndex)
+{
+    if (address < 0x10000000u || address >= 0x10002000u)
+        return -1;
+    const uint32_t offset = address - 0x10000000u;
+    const uint32_t index = offset >> 11;       // 0x800 apart
+    const uint32_t within = offset & 0x7FFu;
+    if (index > 3u || (within & 0xFu) != 0u || within > 0x30u)
+        return -1;
+    if (regIndex)
+        *regIndex = within >> 4;
+    return static_cast<int>(index);
+}
+
+// Bring `baseCount`/`baseNs` up to now, latching the sticky compare/overflow
+// flags on the way. PCSX2's `rcntSyncCounter` equivalent.
+void PS2Memory::eeTimerSync(int index)
+{
+    EeTimer &t = m_eeTimers[index];
+    const uint64_t now = eeTimerNowNs();
+
+    // CUE clear: the counter is stopped, so time passing must not accumulate.
+    if ((t.mode & (1u << 7)) == 0u)
+    {
+        t.baseNs = now;
+        return;
+    }
+    if (now <= t.baseNs)
+    {
+        t.baseNs = now;
+        return;
+    }
+
+    const uint64_t rateHz = eeTimerTickHz(t.mode);
+    const unsigned __int128 elapsedNs = static_cast<unsigned __int128>(now - t.baseNs);
+    const unsigned __int128 ticks128 = (elapsedNs * rateHz) / 1000000000u;
+    if (ticks128 == 0)
+        return; // keep the sub-tick remainder in baseNs rather than losing it
+
+    // ZRET wraps at COMP instead of at 0xFFFF.
+    const bool zret = (t.mode & (1u << 6)) != 0u;
+    const uint32_t modulus =
+        (zret && (t.compare & 0xFFFFu) != 0u) ? ((t.compare & 0xFFFFu) + 1u) : 0x10000u;
+
+    // Cap the advance: a long stall must not spin this into a 128-bit loop.
+    const unsigned __int128 kCap = static_cast<unsigned __int128>(1ull << 40);
+    const uint64_t ticks = static_cast<uint64_t>(ticks128 > kCap ? kCap : ticks128);
+
+    const uint64_t start = t.baseCount;
+    const uint64_t raw = start + ticks;
+
+    if (raw >= modulus)
+        t.mode |= zret ? (1u << 10) : (1u << 11); // EQUF on ZRET wrap, else OVFF
+    // Compare flag: did the count cross COMP on the way up (possibly wrapping)?
+    if (!zret)
+    {
+        const uint64_t comp = t.compare & 0xFFFFu;
+        if (ticks >= modulus || (start < comp && raw >= comp) ||
+            (raw >= modulus && (raw % modulus) >= comp))
+            t.mode |= (1u << 10);
+    }
+
+    t.baseCount = static_cast<uint32_t>(raw % modulus);
+    // Advance baseNs by exactly the ticks consumed so the remainder survives.
+    t.baseNs += static_cast<uint64_t>(
+        (static_cast<unsigned __int128>(ticks) * 1000000000u) / rateHz);
+}
+
+uint32_t PS2Memory::eeTimerRead(int index, uint32_t reg)
+{
+    EeTimer &t = m_eeTimers[index];
+    eeTimerSync(index);
+    switch (reg)
+    {
+    case 0: return t.baseCount & 0xFFFFu; // COUNT
+    case 1: return t.mode & 0xFFFu;       // MODE
+    case 2: return t.compare & 0xFFFFu;   // COMP
+    default: return t.hold;               // HOLD
+    }
+}
+
+void PS2Memory::eeTimerWrite(int index, uint32_t reg, uint32_t value)
+{
+    EeTimer &t = m_eeTimers[index];
+    switch (reg)
+    {
+    case 0: // COUNT — rcntWcount
+        eeTimerSync(index);
+        t.baseCount = value & 0xFFFFu;
+        t.baseNs = eeTimerNowNs();
+        break;
+    case 1: // MODE — rcntWmode
+        // Sync FIRST, on the old clock select, so time already elapsed is
+        // credited at the rate it actually elapsed at.
+        eeTimerSync(index);
+        {
+            // Bits 10/11 are write-1-to-clear; the rest are taken from `value`.
+            // PCSX2: modeval &= ~(value & 0xc00); modeval = (modeval & 0xc00) | (value & 0x3ff);
+            uint32_t m = t.mode;
+            m &= ~(value & 0xC00u);
+            m = (m & 0xC00u) | (value & 0x3FFu);
+            t.mode = m;
+        }
+        // NOTE: writing MODE does NOT reset COUNT (verified against PCSX2
+        // `rcntWmode` @ d5f75c9e4 — it only re-bases startCycle).
+        t.baseNs = eeTimerNowNs();
+        break;
+    case 2: // COMP — rcntWtarget
+        eeTimerSync(index);
+        t.compare = value & 0xFFFFu;
+        break;
+    default: // HOLD — rcntWhold
+        t.hold = value;
+        break;
+    }
+}
