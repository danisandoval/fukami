+void GSDrawScanline::GetStaticFunctions(GSScanlineSelector sel, SetupPrimPtr& setup_prim, DrawScanlinePtr& draw_scanline, DrawScanlinePtr& draw_edge)
+{
+	static const bool s_sorted = [] {
+		const bool ok = RrvTableSorted(s_rrv_static_ds) && RrvTableSorted(s_rrv_static_sp);
+		if (!ok)
+			std::fprintf(stderr, "[pcsx2-sw] static rasterizer table is not sorted; using generic C functions only\n");
+		return ok;
+	}();
+
+	DrawScanlinePtr ds = s_sorted ? RrvLookupStatic(s_rrv_static_ds, sel.key) : nullptr;
+	SetupPrimPtr sp = s_sorted ? RrvLookupStatic(s_rrv_static_sp, SetupPrimKey(sel)) : nullptr;
+
+	draw_scanline = ds ? ds : static_cast<DrawScanlinePtr>(&GSDrawScanline::CDrawScanline);
+	setup_prim = sp ? sp : static_cast<SetupPrimPtr>(&GSDrawScanline::CSetupPrim);
+
+	if (sel.aa1)
+	{
+		DrawScanlinePtr de = s_sorted ? RrvLookupStatic(s_rrv_static_ds, EdgeKey(sel)) : nullptr;
+		draw_edge = de ? de : &GSDrawScanline::CDrawEdge;
+	}
+	else
+	{
+		draw_edge = nullptr;
+	}
+}
+
+size_t GSDrawScanline::StaticTableSize()
+{
+	return std::size(s_rrv_static_ds) - 1;
+}
