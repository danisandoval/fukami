+u64 RrvMetalLifetimePointer(id object)
+{
+	return static_cast<u64>(reinterpret_cast<uintptr_t>((__bridge void*)object));
+}
+
+u64 RrvMetalLifetimeThread()
+{
+	return static_cast<u64>(std::hash<std::thread::id>{}(std::this_thread::get_id()));
+}
+
+const char* RrvMetalLifetimeEventName(rrv::metal_lifetime::Event event)
+{
+	using Event = rrv::metal_lifetime::Event;
+	switch (event)
+	{
+		case Event::Attach: return "attach";
+		case Event::Detach: return "detach";
+		case Event::UpdateWindow: return "update-window";
+		case Event::DestroySurface: return "destroy-surface";
+		case Event::Destroy: return "destroy";
+		case Event::CommandBufferCreate: return "command-buffer-create";
+		case Event::Commit: return "commit";
+		case Event::Complete: return "complete";
+		case Event::SpinComplete: return "spin-complete";
+		case Event::DrawableAcquire: return "drawable-acquire";
+		case Event::DrawablePresent: return "drawable-present";
+		case Event::DeviceReady: return "device-ready";
+		case Event::PipelineReady: return "pipeline-ready";
+		case Event::PresentConfig: return "present-config";
+		case Event::InterlaceConfig: return "interlace-config";
+	}
+	return "unknown";
+}
+
+void RrvMetalLifetimeRecordRaw(rrv::metal_lifetime::Event event, u64 command_buffer, u64 queue,
+	u64 layer, u64 drawable, u64 draw, u64 status, u64 surface_width = 0,
+	u64 surface_height = 0, u64 pixel_format = 0, u64 reacquire_before_complete = 0)
+{
+	if (!s_rrv_metal_lifetime.enabled())
+		return;
+	s_rrv_metal_lifetime.record(event, command_buffer, queue, layer, drawable, draw, status,
+		RrvMetalLifetimeThread(), surface_width, surface_height, pixel_format, reacquire_before_complete);
+}
+
+void RrvMetalLifetimeSurface(CAMetalLayer* layer, u64* surface_width, u64* surface_height, u64* pixel_format)
+{
+	*surface_width = 0;
+	*surface_height = 0;
+	*pixel_format = 0;
+	if (!layer)
+		return;
+	const CGSize size = [layer drawableSize];
+	*surface_width = static_cast<u64>(size.width);
+	*surface_height = static_cast<u64>(size.height);
+	*pixel_format = static_cast<u64>([layer pixelFormat]);
+}
+
+void RrvMetalLifetimeRecord(rrv::metal_lifetime::Event event, id<MTLCommandBuffer> command_buffer,
+	id<MTLCommandQueue> queue, CAMetalLayer* layer, id<CAMetalDrawable> drawable, u64 draw,
+	u64 reacquire_before_complete = 0)
+{
+	if (!s_rrv_metal_lifetime.enabled())
+		return;
+	u64 surface_width, surface_height, pixel_format;
+	RrvMetalLifetimeSurface(layer, &surface_width, &surface_height, &pixel_format);
+	RrvMetalLifetimeRecordRaw(event, RrvMetalLifetimePointer(command_buffer), RrvMetalLifetimePointer(queue),
+		RrvMetalLifetimePointer(layer), RrvMetalLifetimePointer(drawable), draw,
+		command_buffer ? static_cast<u64>([command_buffer status]) : 0,
+		surface_width, surface_height, pixel_format, reacquire_before_complete);
+}
+
+u64 RrvMetalLifetimeFloatBits(float value)
+{
+	u32 bits;
+	std::memcpy(&bits, &value, sizeof(bits));
+	return bits;
+}
+
+u64 RrvMetalLifetimeConfigSignature(const GSVector4& source, const GSVector4& target, u64 source_width,
+	u64 source_height, u64 target_width, u64 target_height, u64 selector, u64 filter, u64 pipeline)
+{
+	u64 hash = 1469598103934665603ull;
+	const auto mix = [&hash](u64 value) { hash = (hash ^ value) * 1099511628211ull; };
+	mix(RrvMetalLifetimeFloatBits(source.x)); mix(RrvMetalLifetimeFloatBits(source.y));
+	mix(RrvMetalLifetimeFloatBits(source.z)); mix(RrvMetalLifetimeFloatBits(source.w));
+	mix(RrvMetalLifetimeFloatBits(target.x)); mix(RrvMetalLifetimeFloatBits(target.y));
+	mix(RrvMetalLifetimeFloatBits(target.z)); mix(RrvMetalLifetimeFloatBits(target.w));
+	mix(source_width); mix(source_height); mix(target_width); mix(target_height);
+	mix(selector); mix(filter); mix(pipeline);
+	return hash;
+}
+
+void RrvMetalLifetimeRecordConfigIfChanged(rrv::metal_lifetime::Event event, std::atomic<u64>& previous,
+	u64 signature, id pipeline, id<MTLTexture> output,
+	id<MTLCommandQueue> queue, CAMetalLayer* layer, id<CAMetalDrawable> drawable, u64 draw)
+{
+	if (!s_rrv_metal_lifetime.enabled() || previous.exchange(signature, std::memory_order_relaxed) == signature)
+		return;
+	const u64 output_width = output ? static_cast<u64>([output width]) : 0;
+	const u64 output_height = output ? static_cast<u64>([output height]) : 0;
+	const u64 output_format = output ? static_cast<u64>([output pixelFormat]) : 0;
+	RrvMetalLifetimeRecordRaw(event, RrvMetalLifetimePointer(pipeline), RrvMetalLifetimePointer(queue),
+		RrvMetalLifetimePointer(layer), RrvMetalLifetimePointer(drawable), draw, signature,
+		output_width, output_height, output_format);
+}
