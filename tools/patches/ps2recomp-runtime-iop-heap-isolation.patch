+
+    bool isSifIopHeapEndpoint(uint32_t addr)
+    {
+        // Only the explicit SIF IOP endpoints use this range. Low-address
+        // synthetic RPC storage keeps its existing EE route.
+        const uint32_t normalized = addr & ~0x40000000u;
+        return normalized >= kIopHeapBase && normalized < kIopHeapLimit;
+    }
+
+    bool readIopHeapBytes(uint32_t addr, uint8_t *dst, size_t size)
+    {
+        std::lock_guard<std::mutex> lock(g_sifHeapMutex);
+        if (!dst || !ownsIopHeapRangeLocked(addr, size))
+            return false;
+        std::memcpy(dst, g_sifHeapBytes.data() + (addr - kIopHeapBase), size);
+        return true;
+    }
+
+    bool writeIopHeapBytes(uint32_t addr, const uint8_t *src, size_t size)
+    {
+        std::lock_guard<std::mutex> lock(g_sifHeapMutex);
+        if (!src || !ownsIopHeapRangeLocked(addr, size))
+            return false;
+        std::memcpy(g_sifHeapBytes.data() + (addr - kIopHeapBase), src, size);
+        return true;
+    }
