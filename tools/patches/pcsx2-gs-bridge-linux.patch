+// RRV GS bridge (pcsx2-gs-bridge-linux.patch): where the GS thread waits on
+// the GPU, and what the HW renderer's CPU fallbacks cost. Monotonic totals,
+// written and read on the GS thread only (the bridge samples them in GSvsync).
+// Observation only: nothing reads them back into a GS decision.
+enum class GSRrvWait : u8
+{
+	Other,    // a fence wait with no more specific cause
+	Forced,   // ExecuteCommandBuffer(wait) and downloads: a GPU->CPU readback
+	Rotation, // reusing a command buffer the GPU has not finished
+	Stream,   // a vertex/index/uniform/texture stream buffer ran out of space
+	Count
+};
+enum class GSRrvRead : u8
+{
+	Other,     // texture-cache lookups, ReadbackAll
+	SwPrim,    // CanUseSwPrimRender: source target read for the CPU sprite path
+	LocalRead, // InvalidateLocalMem: the guest reads GS memory (TRXDIR=1)
+	Count
+};
+struct GSRrvWaitStats
+{
+	u64 wait_ns[static_cast<size_t>(GSRrvWait::Count)];
+	u64 waits[static_cast<size_t>(GSRrvWait::Count)];
+	u64 acquire_ns, acquires; // vkAcquireNextImageKHR: time the GS thread was blocked in it or on it
+	u64 acquire_bg_ns; // its time on the helper thread (even frame pacing on)
+	u64 present_ns, presents; // vkQueuePresentKHR
+	u64 submits, midframe_submits; // vkQueueSubmit; those without a present
+	u64 sw_prim_ns, sw_prims; // SwPrimRender (CPU sprite/CLUT draws)
+	u64 read_ns[static_cast<size_t>(GSRrvRead::Count)];
+	u64 reads[static_cast<size_t>(GSRrvRead::Count)];
+	u64 read_pixels; // GSTextureCache::Read area, unscaled pixels
+	u32 swapchain_images;
+	bool async_acquire;
+};
+extern GSRrvWaitStats g_rrv_wait_stats;
+extern GSRrvWait g_rrv_wait_reason;
+extern GSRrvRead g_rrv_read_cause;
+u64 GSRrvNowNs();
+// Sets the cause of the fence waits in its scope.
+struct GSRrvWaitReasonScope
+{
+	GSRrvWait saved;
+	explicit GSRrvWaitReasonScope(GSRrvWait reason) : saved(g_rrv_wait_reason) { g_rrv_wait_reason = reason; }
+	~GSRrvWaitReasonScope() { g_rrv_wait_reason = saved; }
+};
+// Sets the cause of the texture-cache reads in its scope.
+struct GSRrvReadCauseScope
+{
+	GSRrvRead saved;
+	explicit GSRrvReadCauseScope(GSRrvRead cause) : saved(g_rrv_read_cause) { g_rrv_read_cause = cause; }
+	~GSRrvReadCauseScope() { g_rrv_read_cause = saved; }
