+// RRV (Linux/Vulkan bridge): consumes one whole 256-byte block into a streaming state straight from its source,
+// exactly as XXH3_64bits_update() does when it consumes its internal buffer, without first copying the block into
+// that buffer. The caller (BlockHashAccumulate, GSTextureCache.cpp) keeps the state's invariants.
+void CURRENT_ISA::GSXXH3_64_Block256(void* state, const void* block)
+{
+	XXH3_state_t* st = static_cast<XXH3_state_t*>(state);
+	const unsigned char* secret = (st->extSecret == NULL) ? st->customSecret : st->extSecret;
+	XXH3_consumeStripes(st->acc, &st->nbStripesSoFar, st->nbStripesPerBlock, static_cast<const xxh_u8*>(block),
+		256 / XXH_STRIPE_LEN, secret, st->secretLimit, XXH3_accumulate, XXH3_scrambleAcc);
+}
